<%- include('partials/head', { title }) %>
<%- include('partials/header') %>
<main class="section"><div class="wrap">
  <h1 class="page-title">Tu carrito</h1>
  <% if (!items.length) { %>
    <p class="empty">Tu carrito está vacío. <a href="/products">Ver perfumes</a></p>
  <% } else { %>
  <div class="cart">
    <div>
      <% items.forEach(i => { %>
      <article class="cart-item">
        <div class="cart-thumb"><%- include('partials/bottle', { p: i.product }) %></div>
        <div>
          <h3><%= i.product.name %></h3><small><%= i.product.category === 'hombre' ? 'Hombre' : 'Mujer' %> · 100 ml</small>
          <div class="qty">
            <form method="post" action="/cart/update/<%= i.product.id %>" style="display:contents">
              <input type="hidden" name="q" value="<%= i.qty - 1 %>">
              <button type="submit" aria-label="Menos">−</button>
            </form>
            <span><%= i.qty %></span>
            <form method="post" action="/cart/update/<%= i.product.id %>" style="display:contents">
              <input type="hidden" name="q" value="<%= i.qty + 1 %>">
              <button type="submit" aria-label="Más">+</button>
            </form>
          </div>
        </div>
        <div>
          <div class="price"><%= money(i.product.price * i.qty) %></div>
          <form method="post" action="/cart/remove/<%= i.product.id %>" style="display:contents">
            <button class="remove" type="submit">Eliminar</button>
          </form>
        </div>
      </article>
      <% }) %>
    </div>
    <aside class="summary">
      <h2>Resumen</h2>
      <ul><li>Subtotal<span><%= money(subtotal) %></span></li><li>Envío<span>Gratis</span></li><li class="total">Total<b><%= money(subtotal) %></b></li></ul>
      <%
        const msg = 'Hola, quiero comprar:\n'
          + items.map(i => '- ' + i.qty + ' x ' + i.product.name + ' (' + money(i.product.price * i.qty) + ')').join('\n')
          + '\nTotal: ' + money(subtotal);
      %>
      <a class="btn btn-solid btn-block" target="_blank" rel="noopener" href="<%= waLink(msg) %>">Comprar por WhatsApp</a>
      <p class="empty">Paga contra entrega en todo el país</p>
      <p class="empty"><a href="/products">← Seguir comprando</a></p>
    </aside>
  </div>
  <% } %>
</div></main>
<%- include('partials/footer') %>
<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="section"><div class="wrap">
  <div class="section-head"><span class="eyebrow">Catálogo</span><h2>Perfumes</h2></div>
  <div class="filters">
    <a class="chip <%= !category ? 'active' : '' %>" href="/products">Todos</a>
    <a class="chip <%= category === 'hombre' ? 'active' : '' %>" href="/products?category=hombre">Hombre</a>
    <a class="chip <%= category === 'mujer' ? 'active' : '' %>" href="/products?category=mujer">Mujer</a>
    <a class="chip admin" href="/products/create">+ Nuevo producto</a>
  </div>
  <div class="prod-grid">
    <% products.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %>
  </div>
</div></main>
<%- include('../partials/footer') %>

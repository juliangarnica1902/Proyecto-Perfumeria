<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="auth"><div class="wrap"><div class="auth-box">
  <h1>Iniciar sesión</h1>
  <% if (typeof error !== 'undefined' && error) { %><p class="msg-error" style="display:block"><%= error %></p><% } %>
  <form method="post" action="/users/login" novalidate>
    <div class="field"><label for="email">Correo</label>
      <input id="email" name="email" type="email" value="<%= (old && old.email) || '' %>" placeholder="tucorreo@ejemplo.com"></div>
    <div class="field"><label for="password">Contraseña</label>
      <input id="password" name="password" type="password"></div>
    <button class="btn btn-solid btn-block" type="submit">Ingresar</button>
  </form>
  <p class="alt">¿No tienes cuenta? <a href="/users/register">Regístrate</a></p>
</div></div></main>
<%- include('../partials/footer') %>
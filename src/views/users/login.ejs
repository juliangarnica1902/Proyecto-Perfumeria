<% const e = (n) => (typeof errors !== 'undefined' && errors[n]) ? errors[n].msg : ''; %>
<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="auth"><div class="wrap"><div class="auth-box">
  <h1>Iniciar sesión</h1>
  <form data-validate="login" method="post" action="/users/login" novalidate>
    <div class="field <%= e('email') ? 'error' : '' %>"><label for="email">Correo</label>
      <input id="email" name="email" type="email" value="<%= (old && old.email) || '' %>" placeholder="tucorreo@ejemplo.com">
      <p class="msg-error"><%= e('email') %></p></div>
    <div class="field <%= e('password') ? 'error' : '' %>"><label for="password">Contraseña</label>
      <input id="password" name="password" type="password">
      <p class="msg-error"><%= e('password') %></p></div>
    <div class="row"><label><input type="checkbox" name="remember" value="1"> Recordarme</label></div>
    <button class="btn btn-solid btn-block" type="submit">Ingresar</button>
  </form>
  <p class="alt">¿No tienes cuenta? <a href="/users/register">Regístrate</a></p>
</div></div></main>
<script src="/js/validations.js"></script>
<%- include('../partials/footer') %>

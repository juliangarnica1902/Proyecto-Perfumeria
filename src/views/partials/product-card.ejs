<div class="prod-card">
  <a class="prod-thumb" href="/products/<%= p.id %>">
    <% if (p.badge) { %><span class="prod-badge"><%= p.badge %></span><% } %>
    <%- include('bottle', { p }) %>
  </a>
  <div class="prod-info">
    <div class="prod-brand"><%= p.category === 'hombre' ? 'Hombre' : 'Mujer' %></div>
    <div class="prod-name"><%= p.name %></div>
    <div class="prod-desc"><%= p.description %></div>
    <div class="prod-footer"><div class="prod-price"><%= money(p.price) %></div></div>
    <form method="post" action="/cart/add/<%= p.id %>">
      <button class="btn btn-block" type="submit">Añadir al carrito</button>
    </form>
  </div>
</div>
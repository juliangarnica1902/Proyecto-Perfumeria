<% const v = typeof product !== 'undefined' ? product : {};
   const e = (n) => (typeof errors !== 'undefined' && errors[n]) ? errors[n].msg : ''; %>
<form data-validate="product" method="post" action="<%= v.id ? '/products/' + v.id + '?_method=PUT' : '/products' %>" enctype="multipart/form-data" novalidate>
  <div class="field <%= e('name') ? 'error' : '' %>"><label for="name">Nombre del producto</label>
    <input id="name" name="name" type="text" value="<%= v.name || '' %>" placeholder="Ej: Born in Roma">
    <p class="msg-error"><%= e('name') %></p></div>
  <div class="field <%= e('description') ? 'error' : '' %>"><label for="description">Descripción</label>
    <textarea id="description" name="description" placeholder="Notas, familia olfativa... (mínimo 20 caracteres)"><%= v.description || '' %></textarea>
    <p class="msg-error"><%= e('description') %></p></div>
  <div class="field <%= e('image') ? 'error' : '' %>"><label for="image">Imagen (JPG, PNG o GIF)</label>
    <input id="image" name="image" type="file" accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif">
    <% if (v.image) { %>
      <img id="preview" src="<%= v.image %>" alt="Vista previa" style="max-width:200px;margin-top:10px">
    <% } else { %>
      <img id="preview" hidden alt="Vista previa" style="max-width:200px;margin-top:10px">
    <% } %>
    <p class="msg-error"><%= e('image') %></p></div>
  <div class="two">
    <div class="field <%= e('category') ? 'error' : '' %>"><label for="category">Categoría</label>
      <select id="category" name="category">
        <option value="hombre" <%= v.category === 'hombre' ? 'selected' : '' %>>Hombre</option>
        <option value="mujer" <%= v.category === 'mujer' ? 'selected' : '' %>>Mujer</option>
      </select>
      <p class="msg-error"><%= e('category') %></p></div>
    <div class="field <%= e('price') ? 'error' : '' %>"><label for="price">Precio (COP)</label>
      <input id="price" name="price" type="number" min="0" value="<%= v.price || '' %>" placeholder="185000">
      <p class="msg-error"><%= e('price') %></p></div>
  </div>
  <div class="field"><label for="colors">Colores / tamaños</label>
    <input id="colors" name="colors" type="text" value="<%= Array.isArray(v.colors) ? v.colors.join(', ') : (v.colors || '') %>" placeholder="Ej: Ámbar, dorado"></div>
  <button class="btn btn-solid btn-block" type="submit"><%= v.id ? 'Guardar cambios' : 'Crear producto' %></button>
</form>
<script>
  document.getElementById('image').addEventListener('change', function (ev) {
    var f = ev.target.files[0], img = document.getElementById('preview');
    if (f && /^image\//.test(f.type)) { img.src = URL.createObjectURL(f); img.hidden = false; }
  });
</script>
<script src="/js/validations.js"></script>
